{
  "manifest_version": 3,
  "name": "Study Focus Extension",
  "version": "1.0",
  "description": "Blocks distracting websites during study time",
  "permissions": ["storage", "tabs", "alarms", "notifications","declarativeNetRequest"],
"host_permissions": [
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://*.tik-tok.com/*",
    "*://*.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
      },
      "web_accessible_resources": [
        {
          "resources": ["blocked.html"],
          "matches": ["<all_urls>"]
        }
      ]
    
  }

